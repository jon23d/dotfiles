# Copy to .env for local development (never commit .env itself).
# In production this daemon reads these from the systemd EnvironmentFile
# written by run_onchange_install-control-plane-daemon.sh.tmpl, not from
# a .env file.

# Personal Access Token for the `devsix` Mattermost bot account. Resolved
# automatically at install time from ~/.config/secrets.env's
# MATTERMOST_TOKEN_<HOSTNAME> value; only needed here for local dev.
MATTERMOST_MCP_TOKEN=

# Optional overrides -- sensible defaults are baked in.
# MATTERMOST_URL=https://mattermost.jon23d.cc
# OPERATOR_EMAIL=jon23d@gmail.com
# STATE_FILE_PATH=/home/you/.local/state/control-plane-daemon/state.json
# LOG_LEVEL=info
