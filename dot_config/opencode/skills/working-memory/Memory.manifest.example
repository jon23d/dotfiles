# memory.manifest.yaml — lives at the repo root of each service.
#
# Purpose: declares this repo's memory scope and its dependencies/edges so the
# agent's READ scope is DECLARED, not guessed. The `dependencies` and `edges`
# lists below are also the canonical-name menu: the agent files cross-cutting
# facts by picking from these, and must not invent new names.
#
# Example shown for Innkeeper's `portal` service.

domain: innkeeper                 # innkeeper | harness — hard boundary
project: project/portal           # this repo's own scope

# Shared dependencies this service touches. Names here are canonical — they map
# 1:1 to dep/<name> notes in the memory store. Add a dep here BEFORE writing a
# fact about it, so naming stays consistent across projects.
dependencies:
  - dep/square                    # Square Terminal API
  - dep/postgres                  # Postgres w/ row-level security
  - dep/pg-boss                   # job queue
  - dep/couchbase                 # via the api service
  - dep/r2                        # Cloudflare R2 (OCI registry / assets)

# Service-to-service seams this repo participates in. Canonical, undirected;
# name alphabetically so edge/portal--api == edge/api--portal.
edges:
  - edge/portal--api

# Cross-cutting scopes always loaded on top of the above. Keep the global tier
# thin — infra/tooling only.
always_load:
  - innkeeper/global              # org-wide Innkeeper invariants (rare)
  - global/infra                  # gitea, doks, litellm — cross-domain infra

# Resolved READ scope for any ticket in this repo is the union of:
#   project + dependencies + edges + always_load
# The agent loads exactly this set and no more. Do not widen at runtime;
# add scopes here if a new dependency is introduced.
