{
	"$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 4,
   "permission": {
    "*": "allow",
    "bash": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
	"mcp": {
		"gitea-mcp": {
			"enabled": true,
			"type": "local",
			"command": [
				"gitea-mcp",
				"-t", "stdio",
				"-H", "{env:GITEA_URL}",
				"-T", "{env:GITEA_MCP_TOKEN}"
			]
		},
    "basic-memory": {
      "type": "remote",
      "url": "{env:BASIC_MEMORY_URL}",
      "enabled": true,
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_TOKEN}"
      }
    },
    "mcp-atlassian": {
      "enabled": true,
      "type": "local",
      "command": ["uvx", "--with", "atlassian-python-api<5.0.0", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    }
	},
	"provider": {
		"litellm": {
			"name": "LiteLLM",
			"npm": "@ai-sdk/openai-compatible",
			"models": {
				"glm-5.2": {
					"name": "glm-5.2",
					"limit": {
						"context": 650000,
						"output": 100000
					}
				},
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 200000,
            "output": 184000
          }
        },
				"minimax": {
					"name": "minimax",
					"limit": {
						"context": 196608,
						"output": 32000
					}
				},
				"qwen3.6-35b": {
					"name": "qwen3.6-35b",
					"limit": {
						"context": 262144,
						"output": 32000
					}
				},
				"small-model": {
					"name": "small-model",
					"limit": {
						"context": 4096,
						"output": 2048
					}
				}
			},
			"options": {
				"baseURL": "{env:LITELLM_URL}",
				"apiKey": "{env:LITELLM_KEY}"
			}
		}
	}
}
