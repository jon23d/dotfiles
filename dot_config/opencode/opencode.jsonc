{
	"$schema": "https://opencode.ai/config.json",
  // KAN-13: explicit default model, in "provider/model" form per opencode's config schema
  // (dot_config/opencode.json's own $schema, `Config.model`). Without this, opencode's own
  // default-model resolution for the `litellm` provider silently picked `small-model`
  // (4096-token context), which the Orchestrator agent's system prompt + MCP tool schemas
  // always overflowed -- causing an unbounded compaction loop (LiteLLM correctly rejects the
  // oversized request, but opencode's auto-continue handler can only shrink conversation
  // history, not the fixed prompt/tool-schema overhead that was actually oversized here). Full
  // root cause: .agent/research-kan13.md. Confirmed `deepseek-v4-pro` live via LiteLLM's own
  // `GET {LITELLM_URL}/models` and `GET {LITELLM_URL}/model/info` -- 1,000,000-token input
  // context / 8,192-token max output, routed to the real DeepSeek API
  // (`custom_llm_provider: "deepseek"`), not the local LM Studio backend the other models here
  // use.
  "model": "litellm/deepseek-v4-pro",
  "subagent_depth": 4,
   "permission": {
    "*": "allow",
    "bash": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
	"mcp": {
		"gitea-mcp": {
			"enabled": true,
			"type": "local",
			"command": [
				"gitea-mcp",
				"-t", "stdio",
				"-H", "{env:GITEA_URL}",
				"-T", "{env:GITEA_MCP_TOKEN}"
			]
		},
    "basic-memory": {
      "type": "remote",
      "url": "{env:BASIC_MEMORY_URL}",
      "enabled": true,
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_TOKEN}"
      }
    },
    "mcp-atlassian": {
      "enabled": true,
      "type": "local",
      "command": ["uvx", "--with", "atlassian-python-api<5.0.0", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "mattermost": {
      "type": "remote",
      "url": "{env:MATTERMOST_MCP_URL}",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MATTERMOST_MCP_TOKEN}"
      }
    }
	},
	"provider": {
		"litellm": {
			"name": "LiteLLM",
			"npm": "@ai-sdk/openai-compatible",
			"models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 200000,
            "output": 184000
          }
        },
				"minimax": {
					"name": "minimax",
					"limit": {
						"context": 196608,
						"output": 32000
					}
				},
				"qwen3.6-35b": {
					"name": "qwen3.6-35b",
					"limit": {
						"context": 262144,
						"output": 32000
					}
				},
				"small-model": {
					"name": "small-model",
					"limit": {
						"context": 4096,
						"output": 2048
					}
				}
			},
			"options": {
				"baseURL": "{env:LITELLM_URL}",
				"apiKey": "{env:LITELLM_KEY}"
			}
		}
	}
}
