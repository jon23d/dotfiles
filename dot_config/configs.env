# Sooperset atlassian-MCP configuration. This reduces the tools available to a small subset of options
export TOOLSETS=default

# Mattermost's embedded MCP server (Agents plugin, no license needed for
# external clients connecting in -- only remote/external MCP servers that
# Mattermost's own agents call OUT to are license-gated). Auth token is
# per-host -- see MATTERMOST_MCP_TOKEN resolution in zsh/rc.sh.
export MATTERMOST_MCP_URL=https://mattermost.jon23d.cc/plugins/mattermost-ai/mcp-server/mcp
